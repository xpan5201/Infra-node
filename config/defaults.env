# Infra-node fixed paths are an installation contract, not user input.
# 刻意用普通赋值：事务路径白名单由这些值推导，不允许从环境改写。
INFRA_INSTALL_DIR=/opt/infra-node
INFRA_COMMAND_DIR=/usr/local/bin
INFRA_ETC_DIR=/etc/infra-node
INFRA_STATE_DIR=/var/lib/infra-node
INFRA_LOG_DIR=/var/log/infra-node
INFRA_BACKUP_DIR=/var/backups/infra-node

# 以下都是可调项，一律用 `: "${VAR:=默认值}"`：环境变量优先于这里的默认值。
# 用普通赋值会反过来 —— 环境变量被这里盖掉。v1.6.4 之前
# INFRA_PROXY_OOM_SCORE_ADJUST 就是这样变成"文档说可配、实际不可配"的：
# 它在 /opt/infra-node/config/ 下，而那个文件每次 self-update 都会被整个替换。

: "${INFRA_REPO_URL:=https://github.com/xpan5201/Infra-node.git}"
: "${INFRA_REPO_REF:=main}"
# 自更新通道：
#   tag  —— 跟随最新发行 tag（默认）。推送 main 不会立刻影响已装机器，
#           只有打了 tag 的版本才会被 self-update 选中。
#   main —— 跟随 INFRA_REPO_REF。
# 单次可用 `self-update --channel main|tag` 或 `--to-tag` 覆盖。
: "${INFRA_UPDATE_CHANNEL:=tag}"
: "${INFRA_GIT_TIMEOUT:=90}"
: "${INFRA_BACKUP_KEEP:=5}"
# 写给代理 systemd unit 的 OOMScoreAdjust。
#   +100（默认）内存紧张时优先杀代理，保住宿主机与 SSH 会话，代价是业务中断；
#   负数则优先保护代理。纯代理节点可考虑改为负值。详见 README「代理资源限制」。
# 用法：sudo INFRA_PROXY_OOM_SCORE_ADJUST=-500 infra-node --yes deploy --proxy-units <unit>
: "${INFRA_PROXY_OOM_SCORE_ADJUST:=100}"
: "${INFRA_FIREWALL_ROLLBACK_SECONDS:=300}"
: "${INFRA_TEST_URL:=https://www.cloudflare.com/cdn-cgi/trace}"
: "${INFRA_NO_COLOR:=0}"
: "${INFRA_NON_INTERACTIVE:=0}"
: "${INFRA_ASSUME_YES:=0}"
: "${INFRA_DRY_RUN:=0}"
